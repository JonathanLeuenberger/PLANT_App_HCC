<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/PlantSearchFragment">

    <fragment
        android:id="@+id/PlantSearchFragment"
        android:name="com.example.plant_app_hcc.search.PlantSearchFragment"
        android:label="Plant search" />

    <fragment
        android:id="@+id/PlantDetailsFragment"
        android:name="com.example.plant_app_hcc.search.PlantDetailsFragment"
        android:label="Plant information" />

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.plant_app_hcc.FirstFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_SecondFragment"
            app:destination="@id/SecondFragment" />
    </fragment>
    <fragment
        android:id="@+id/SecondFragment"
        android:name="com.example.plant_app_hcc.SecondFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_second">

        <action
            android:id="@+id/action_SecondFragment_to_FirstFragment"
            app:destination="@id/FirstFragment" />
    </fragment>
</navigation>
