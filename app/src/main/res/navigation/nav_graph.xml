<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/FirstFragment">

    <fragment
        android:id="@+id/FirstFragment"
        android:name="com.example.plant_app_hcc.FirstFragment"
        android:label="Home"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_FirstFragment_to_PlantSearchFragment"
            app:destination="@id/PlantSearchFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_AddPlantFragment"
            app:destination="@id/AddPlantFragment" />
        <action
            android:id="@+id/action_FirstFragment_to_PlaceholderFragment"
            app:destination="@id/PlaceholderFragment" />
    </fragment>

    <fragment
        android:id="@+id/PlantSearchFragment"
        android:name="com.example.plant_app_hcc.search.PlantSearchFragment"
        android:label="Plant search" />

    <fragment
        android:id="@+id/PlantDetailsFragment"
        android:name="com.example.plant_app_hcc.search.PlantDetailsFragment"
        android:label="Plant information" />

    <fragment
        android:id="@+id/AddPlantFragment"
        android:name="com.example.plant_app_hcc.AddPlantFragment"
        android:label="Add Plant"
        tools:layout="@layout/fragment_add_plant" />

    <fragment
        android:id="@+id/PlaceholderFragment"
        android:name="com.example.plant_app_hcc.PlaceholderFragment"
        android:label="Section"
        tools:layout="@layout/fragment_placeholder">
        <argument
            android:name="title"
            app:argType="string"
            android:defaultValue="Section" />
    </fragment>

</navigation>
